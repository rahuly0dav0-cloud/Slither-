/* ---- feat_bins: ARRAY + DO-loop log-binning ---- */
data demo.feat_bins;
    set demo.base_clean;
    array src {5} income balance credit_score utilization num_txns;
    array bin {5} bin_income bin_balance bin_score bin_util bin_txns;
    do i = 1 to 5;
        if src{i} <= 0 then bin{i} = 0;
        else bin{i} = min(9, 1 + floor(log(max(src{i}, 1))));
    end;
    drop i;
    keep account_id bin_income bin_balance bin_score bin_util bin_txns;
run;

proc sort data=demo.base_clean out=demo.base_sorted; by segment account_id; run;

/* ---- feat_segment_delta: RETAIN + FIRST./LAST. within segment ---- */
data demo.feat_segment_delta;
    set demo.base_sorted;
    by segment;
    retain seg_running_income seg_seq;
    if first.segment then do;
        seg_running_income = 0;
        seg_seq = 0;
    end;
    seg_seq + 1;
    seg_running_income = seg_running_income + income;
    seg_avg_income_sofar = divide(seg_running_income, max(seg_seq, 1));
    income_vs_seg = income - seg_avg_income_sofar;
    keep account_id seg_seq seg_running_income seg_avg_income_sofar income_vs_seg;
run;

/* ---- sort every feature table for the merge ---- */
proc sort data=demo.base_clean; by account_id; run;
proc sort data=demo.feat_ratio_1; by account_id; run;
proc sort data=demo.feat_ratio_2; by account_id; run;
proc sort data=demo.feat_ratio_3; by account_id; run;
proc sort data=demo.feat_ratio_4; by account_id; run;
proc sort data=demo.feat_ratio_5; by account_id; run;
proc sort data=demo.feat_ratio_6; by account_id; run;
proc sort data=demo.feat_ratio_7; by account_id; run;
proc sort data=demo.feat_ratio_8; by account_id; run;
proc sort data=demo.feat_ratio_9; by account_id; run;
proc sort data=demo.feat_prod_1; by account_id; run;
proc sort data=demo.feat_prod_2; by account_id; run;
proc sort data=demo.feat_prod_3; by account_id; run;
proc sort data=demo.feat_prod_4; by account_id; run;
proc sort data=demo.feat_prod_5; by account_id; run;
proc sort data=demo.feat_diff_1; by account_id; run;
proc sort data=demo.feat_diff_2; by account_id; run;
proc sort data=demo.feat_diff_3; by account_id; run;
proc sort data=demo.feat_diff_4; by account_id; run;
proc sort data=demo.feat_diff_5; by account_id; run;
proc sort data=demo.feat_unary; by account_id; run;
proc sort data=demo.feat_capped; by account_id; run;
proc sort data=demo.feat_z; by account_id; run;
proc sort data=demo.feat_bins; by account_id; run;
proc sort data=demo.feat_segment_delta; by account_id; run;

/* ---- final assembly: merge every feature table by account_id ---- */
data demo.account_features;
    merge demo.base_clean(in=in_0) demo.feat_ratio_1(in=in_1) demo.feat_ratio_2(in=in_2) demo.feat_ratio_3(in=in_3) demo.feat_ratio_4(in=in_4) demo.feat_ratio_5(in=in_5) demo.feat_ratio_6(in=in_6) demo.feat_ratio_7(in=in_7) demo.feat_ratio_8(in=in_8) demo.feat_ratio_9(in=in_9) demo.feat_prod_1(in=in_10) demo.feat_prod_2(in=in_11) demo.feat_prod_3(in=in_12) demo.feat_prod_4(in=in_13) demo.feat_prod_5(in=in_14) demo.feat_diff_1(in=in_15) demo.feat_diff_2(in=in_16) demo.feat_diff_3(in=in_17) demo.feat_diff_4(in=in_18) demo.feat_diff_5(in=in_19) demo.feat_unary(in=in_20) demo.feat_capped(in=in_21) demo.feat_z(in=in_22) demo.feat_bins(in=in_23) demo.feat_segment_delta(in=in_24);
    by account_id;
    if in_0;
run;

/* ---- segment-level aggregation ---- */
proc means data=demo.account_features noprint;
    class segment;
    var income balance credit_score utilization num_txns;
    output out=demo.segment_summary
        mean(income)=avg_income
        mean(balance)=avg_balance
        mean(credit_score)=avg_score
        mean(utilization)=avg_util
        n(account_id)=n_accounts;
run;

proc freq data=demo.account_features noprint;
    tables segment / out=demo.segment_counts;
run;

/* ---- model: GLMSELECT on a subset of engineered features ---- */
data demo.model_input;
    set demo.account_features;
    target = (num_complaints >= 1 or late_payments >= 2);
    keep account_id target income balance credit_score age tenure_months utilization num_txns late_payments log_income log_balance p0_3 cap_income bin_score income_vs_seg z_income;
run;

proc glmselect data=demo.model_input plots=none;
    model target = income balance credit_score age tenure_months utilization num_txns late_payments log_income log_balance p0_3 cap_income bin_score income_vs_seg z_income
        / selection=lasso choose=cv cvmethod=block(5);
    output out=demo.model_scored p=predicted r=residual;
run;

