/* SAMPLE 07 - LARGE FEATURE-ENGINEERING PIPELINE (~1000 lines)
   Edge case: a deliberately long, repetitive ETL/feature program to stress
   the converter's context handling. Fully deterministic: reads one wide
   table demo.raw_accounts and builds several hundred engineered features
   across many DATA steps, caps/bins some, aggregates by segment, and ends
   with PROC GLMSELECT. (Feature columns use short indexed names r<i>_<j>,
   p<i>_<j>, d<i>_<j> to stay within SAS's 32-char name limit.)

   Base-column index map (i -> raw column):
      0 -> income
      1 -> balance
      2 -> credit_score
      3 -> age
      4 -> tenure_months
      5 -> num_products
      6 -> num_logins
      7 -> num_calls
      8 -> num_complaints
      9 -> days_since_active
     10 -> utilization
     11 -> late_payments
     12 -> avg_txn_amt
     13 -> max_txn_amt
     14 -> min_txn_amt
     15 -> num_txns
     16 -> savings_balance
     17 -> loan_balance
     18 -> interest_rate
     19 -> discount_rate
*/
libname demo "/prototype/data";

%let asof_year = 2025;
%let cap_pct   = 0.99;

/* ---- step 0: base clean ------------------------------------------------ */
data demo.base_clean;
    set demo.raw_accounts;
    if missing(account_id) then delete;
    if missing(income) then income = 0;
    if missing(balance) then balance = 0;
    if missing(credit_score) then credit_score = 0;
    if missing(age) then age = 0;
    if missing(tenure_months) then tenure_months = 0;
    if missing(num_products) then num_products = 0;
    if missing(num_logins) then num_logins = 0;
    if missing(num_calls) then num_calls = 0;
    if missing(num_complaints) then num_complaints = 0;
    if missing(days_since_active) then days_since_active = 0;
    if missing(utilization) then utilization = 0;
    if missing(late_payments) then late_payments = 0;
    if missing(avg_txn_amt) then avg_txn_amt = 0;
    if missing(max_txn_amt) then max_txn_amt = 0;
    if missing(min_txn_amt) then min_txn_amt = 0;
    if missing(num_txns) then num_txns = 0;
    if missing(savings_balance) then savings_balance = 0;
    if missing(loan_balance) then loan_balance = 0;
    if missing(interest_rate) then interest_rate = 0;
    if missing(discount_rate) then discount_rate = 0;
    length segment $10;
    if credit_score >= 750 then segment = 'PRIME';
    else if credit_score >= 640 then segment = 'NEAR';
    else segment = 'SUB';
    keep account_id segment income balance credit_score age tenure_months num_products num_logins num_calls num_complaints days_since_active utilization late_payments avg_txn_amt max_txn_amt min_txn_amt num_txns savings_balance loan_balance interest_rate discount_rate;
run;

