# Streamlit secrets template — COPY to `.streamlit/secrets.toml` and fill in.
# The real `secrets.toml` is gitignored and must never be committed.
#
# On Streamlit Community Cloud, paste these same keys into
# App → Settings → Secrets (do NOT upload the file).

# --- LLM provider key (matches the `env` name in config/models.py) -----------
GROQ_API_KEY = "your-groq-api-key"

# --- Durable accounts + history (Neon / any Postgres). Optional locally. ------
# When set, the app stores users, profiles and conversion history in Postgres
# instead of local JSON/files, so they survive redeploys. Use Neon's *pooled*
# connection string and keep `sslmode=require`.
DATABASE_URL = "postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# --- Admin accounts (comma-separated usernames). Optional. -------------------
# These users can approve knowledge-base rules and see the Users page. Usernames
# are lower-cased. Defaults to "rahul" if unset.
ADMIN_USERNAMES = "rahul"
